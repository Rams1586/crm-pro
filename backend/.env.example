# Server
PORT=5000
NODE_ENV=development

# MongoDB — local or Atlas
MONGO_URI=mongodb://127.0.0.1:27017/crm-app

# JWT — replace with a long random secret in production
JWT_SECRET=change_this_to_a_very_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173

# Seed demo admin — set a strong password before running `node seed.js`
SEED_ADMIN_PASSWORD=change-me-before-use
